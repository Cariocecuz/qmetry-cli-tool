# QMetry config (contains API keys - each user creates their own)
.qmetry_config.yaml

# QMetry cache (auto-generated, user-specific)
.qmetry_cache.yaml
.qmetry_tc_cache.json

# =============================================================================
# COMPANY/PROJECT-SPECIFIC FILES - DO NOT COMMIT
# =============================================================================

# Feature files (may contain internal product names and test cases)
*.feature

# PDF requirements documents (internal/confidential)
*.pdf

# Exported CSV files (contain test case data)
*_Export.csv

# Project-specific folders (internal test cases)
New Features/
PullToRefresh/

# =============================================================================
# PYTHON
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Debug/temp files
debug_api.py
*.log

# macOS
.DS_Store

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment files
.env
.env.local
.env.*.local

# Virtual Environments
venv/
ENV/
env/
.venv

# =============================================================================
# AUGMENT SKILLS
# =============================================================================

# Symlinks in .augment/skills/ (personal setup, not team-shared)
# Only SKILL.md files should be committed
.augment/skills/*/qmetry-*
!.augment/skills/*/SKILL.md
